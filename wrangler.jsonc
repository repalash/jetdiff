{
    "name": "jetdiff",
    "main": "worker/index.js",
    "compatibility_date": "2026-11-01",
    // wrangler dev (npm start, the tests) builds dist/ on start and again when a file the site serves changes (the
    // build's FILES, sw.js) or the Worker does
    "build": {
        "command": "node tools/build.mjs",
        "watch_dir": [
            "index.html", "404.html", "style.css", "manifest.webmanifest", "robots.txt", "sitemap.xml", "og.png",
            "docs", "js", "icons", "sw.js", "worker"
        ]
    },
    // npm start: on all interfaces, to try the app from a phone
    "dev": {"ip": "0.0.0.0", "port": 3000},
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // the libraries (vendor/, ~160 files on a first visit) skip the Worker: static asset requests are not metered, and
        // dist/_headers gives them their headers (build.mjs)
        "run_worker_first": ["/*", "!/vendor/*"]
    },
    // jetdiff.com and www.jetdiff.com are attached to the Worker in the Cloudflare dashboard, so the deploy token needs
    // rights on this Worker only (no routes, DNS or workers.dev)
    "workers_dev": false,
    "preview_urls": false,
    // Cloudflare's own request logs carry the full URL (private repo names, file paths, the sign-in code): off; the Worker
    // logs one line per request without the query instead
    "observability": {"enabled": true, "logs": {"invocation_logs": false}},
    // the GitHub App behind Sign in with GitHub (github.com/apps/jetdiff-com); its GITHUB_CLIENT_SECRET is a secret set
    // in the Cloudflare dashboard
    "vars": {"GITHUB_CLIENT_ID": "Iv23liekK9vqEhvS7KpX", "GITHUB_APP_SLUG": "jetdiff-com"},
    "keep_vars": true
}
