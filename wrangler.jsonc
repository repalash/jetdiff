{
    "name": "jetdiff",
    "main": "worker/index.js",
    "compatibility_date": "2026-11-01",
    "build": {"command": "node tools/build.mjs"},
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": true
    },
    "routes": [
        {"pattern": "jetdiff.com", "custom_domain": true},
        {"pattern": "www.jetdiff.com", "custom_domain": true}
    ],
    "observability": {"enabled": true},
    // GITHUB_CLIENT_ID, GITHUB_APP_SLUG and the GITHUB_CLIENT_SECRET secret are set in the Cloudflare dashboard
    "keep_vars": true
}
