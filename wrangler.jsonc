{
    "name": "jetdiff",
    "main": "worker/index.js",
    "compatibility_date": "2026-11-01",
    "build": {"command": "node tools/build.mjs"},
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "run_worker_first": true
    },
    // jetdiff.com and www.jetdiff.com are attached to the Worker in the Cloudflare dashboard, so the deploy token needs
    // rights on this Worker only (no routes, DNS or workers.dev)
    "workers_dev": false,
    "preview_urls": false,
    "observability": {"enabled": true},
    // the GitHub App behind Sign in with GitHub (github.com/apps/jetdiff-com); its GITHUB_CLIENT_SECRET is a secret set
    // in the Cloudflare dashboard
    "vars": {"GITHUB_CLIENT_ID": "Iv23liekK9vqEhvS7KpX", "GITHUB_APP_SLUG": "jetdiff-com"},
    "keep_vars": true
}
