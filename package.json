{
  "name": "jetdiff",
  "private": true,
  "description": "Code changes in an IDE-style side-by-side diff, on any device, online or offline.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "test": "playwright test",
    "build": "node tools/build.mjs",
    "deploy": "wrangler deploy",
    "record": "node tools/record-snapshot.cjs",
    "pack": "python3 tools/make-pack.py",
    "themes": "node tools/material-themes.mjs",
    "vendor": "node tools/site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "dompurify": "3.4.18",
    "fflate": "0.8.3",
    "markdown-it": "14.3.3",
    "monaco-editor": "0.52.2",
    "shiki": "4.6.0"
  }
}
